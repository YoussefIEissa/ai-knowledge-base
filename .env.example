# Settings for the local language model. Every value is optional; the
# defaults are shown. To change one, copy this file to .env, uncomment
# the line, and start the backend with:
#
#     uv run --env-file .env uvicorn app:app
#
# These settings affect answer generation only. The embedding model
# (all-MiniLM-L6-v2) is separate and is not configured here.

# GGUF model file. A relative path is resolved from the project root.
# LLM_MODEL_PATH=models/gemma-4-E4B_q4_0-it.gguf

# Context window in tokens. It must hold the question, the five
# retrieved passages, and the answer. Larger values use more memory.
# LLM_CONTEXT_LENGTH=8192

# Longest answer the model may write, in tokens.
# LLM_MAX_TOKENS=1024

# Sampling temperature, from 0 to 2.
# LLM_TEMPERATURE=0.2

# Model layers to run on the GPU: -1 for all, 0 for none. Ignored by
# the default CPU build of llama-cpp-python.
# LLM_GPU_LAYERS=-1

# CPU threads. Leave unset to let llama.cpp choose.
# LLM_THREADS=

# Time limit in seconds, applied twice: to waiting while the model
# answers earlier questions, and then to generating. Past either
# limit the API answers 504.
# LLM_TIMEOUT_SECONDS=120
